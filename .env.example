# ============================================================
# ConcorsoAI — Variabili d'ambiente
# Copia questo file in `.env` e compila i valori. Nessuna chiave
# reale è inclusa qui: inserisci le TUE chiavi.
#
# Dove si usano:
#   - Le variabili SERVER (api/*) sono lette dalle Vercel Functions.
#   - Il client statico (public/) legge le credenziali Supabase dai
#     globali __SUPABASE_URL / __SUPABASE_ANON_KEY (iniettabili in
#     fase di build/deploy). Se non iniettate, usa un fallback pubblico.
#   - Le variabili VITE_* valgono solo per un eventuale futuro build
#     Vite: sono mappate ai globali __SUPABASE_* / __APP_*.
# ============================================================

# ---------- Supabase (richieste: auth, dati, storage) ----------
SUPABASE_URL=https://tuo-progetto.supabase.co
SUPABASE_ANON_KEY=la-tua-anon-key-pubblica
# Alias retrocompatibile letto se SUPABASE_ANON_KEY manca:
# SUPABASE_KEY=
# Server-side SOLO (mai nel client): service role per webhook/piano.
SUPABASE_SERVICE_ROLE_KEY=la-tua-service-role-key
# Firma degli eventi database (Supabase webhooks) — opzionale.
# SUPABASE_WEBHOOK_SECRET=

# ---------- AI provider (api/chat.js + api/_lib/ai.js — OpenAI-compatible) ----------
# Default: OpenRouter. Puoi puntare a qualsiasi endpoint OpenAI-compatible.
AI_API_URL=https://openrouter.ai/api/v1/chat/completions
AI_MODEL=google/gemini-2.5-flash
AI_API_KEY=sk-or-v1-la-tua-chiave
# Metadati per OpenRouter (referrer + title del progetto).
AI_REFERRER=https://concorso-ai.vercel.app
AI_TITLE=ConcorsoAI
# Provider legacy ancora supportato come chiave:
# BLUESMINDS_API_KEY=
# --- Failover (round 53): usato SOLO se il primario esaurisce i tentativi
# retryable (503/rete/timeout). Se vuoto, nessun fallback.
# AI_FALLBACK_URL=https://altro-endpoint-openai-compatible/v1/chat/completions
# AI_FALLBACK_KEY=la-tua-chiave-fallback
# AI_FALLBACK_MODEL=modello-fallback-piu-economico
# --- Modello PICCOLO per la memoria di apprendimento (api/memory.js):
# economico e veloce; MAI usato per le simulazioni.
AI_MEMORY_MODEL=deepseek/deepseek-chat

# ---------- Trascrizione vocale (api/stt.js — Groq Whisper) ----------
GROQ_API_KEY=gsk_la-tua-chiave-groq

# ---------- Email (api/email/*) ----------
RESEND_API_KEY=re_la-tua-chiave-resend
WELCOME_FROM_ADDRESS=ConcorsoAI <no-reply@tuo-dominio.it>
# Segreto condiviso per autenticare chiamate alle API email.
EMAIL_API_SECRET=una-stringa-casuale-lunga
# 1 per non inviare davvero (dry run in sviluppo).
EMAIL_DRY_RUN=

# ---------- Stripe (api/stripe-webhook.js) ----------
STRIPE_SECRET_KEY=sk_live_la-tua-chiave
STRIPE_WEBHOOK_SECRET=whsec_la-tua-chiave

# ---------- Telemetria (api/track.js) ----------
TRACK_API_SECRET=una-stringa-casuale-diversa

# ---------- Mappatura client (solo se build con Vite) ----------
VITE_SUPABASE_URL=https://tuo-progetto.supabase.co
VITE_SUPABASE_ANON_KEY=la-tua-anon-key-pubblica
VITE_APP_URL=https://concorso-ai.vercel.app
# Il provider AI e il modello usati dal client sono quelli SERVER
# (AI_API_URL / AI_MODEL): il client non vede mai chiavi AI.
